<odoo>

    <!-- LIST VIEW -->
    <record id="business_ai_view_list" model="ir.ui.view">
        <field name="name">business.ai.list</field>
        <field name="model">business.ai</field>
        <field name="arch" type="xml">
            <list decoration-danger="stockout_risk == 'high'"
                decoration-warning="stockout_risk == 'medium'">

                <field name="name" string="Analysis"/>
                <field name="product_id" string="Product"/>
                <field name="stock_quantity" string="Stock"/>
                <field name="average_daily_sales" string="Avg. Daily Sales"/>
                <field name="days_until_stockout" string="Days Until Stockout"/>

                <field name="stockout_risk"
                    string="Risk"
                    widget="badge"
                    decoration-danger="stockout_risk == 'high'"
                    decoration-warning="stockout_risk == 'medium'"
                    decoration-success="stockout_risk == 'low'"/>

                <field name="recommended_reorder_quantity"
                    string="Recommended Reorder"/>

            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="business_ai_view_form" model="ir.ui.view">
        <field name="name">business.ai.form</field>
        <field name="model">business.ai</field>
        <field name="arch" type="xml">
            <form>
            
                <header>
                    <button
                        name="action_create_purchase_order"
                        string="Create Purchase Order"
                        type="object"
                        class="btn-primary"
                        invisible="not product_id or recommended_reorder_quantity &lt;= 0"/>
                </header>

                    <sheet>

                        <!-- Header -->
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>

                        <!-- Product Selection -->
                        <group string="Product Analysis">
                            <field name="product_id"/>
                        </group>

                        <!-- Key Metrics -->
                        <separator string="Inventory Overview"/>

                        <group col="4">

                            <group>
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="stock_quantity"/>
                                    </span>
                                    <span class="o_stat_text">
                                        Current Stock
                                    </span>
                                </div>
                            </group>

                            <group>
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="average_daily_sales"/>
                                    </span>
                                    <span class="o_stat_text">
                                        Avg. Daily Sales
                                    </span>
                                </div>
                            </group>

                            <group>
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="days_until_stockout"/>
                                    </span>
                                    <span class="o_stat_text">
                                        Days Until Stockout
                                    </span>
                                </div>
                            </group>

                            <group>
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="recommended_reorder_quantity"/>
                                    </span>
                                    <span class="o_stat_text">
                                        Recommended Reorder
                                    </span>
                                </div>
                            </group>

                        </group>

                        <!-- Risk Assessment -->
                        <separator string="Risk Assessment"/>
                        <group>
                            <field name="stockout_risk"
                                widget="badge"
                                decoration-danger="stockout_risk == 'high'"
                                decoration-warning="stockout_risk == 'medium'"
                                decoration-success="stockout_risk == 'low'"/>

                            <field name="overstock_risk"
                                widget="badge"
                                decoration-danger="overstock_risk == 'high'"
                                decoration-warning="overstock_risk == 'medium'"
                                decoration-success="overstock_risk == 'low'"/>
                        </group>

                        <!-- Recommendation -->
                        <separator string="OdooPulse Recommendation"/>

                        <div class="alert alert-info" role="alert">
                            <field name="recommendation" nolabel="1"/>
                        </div>

                        <separator string="Why OdooPulse Made This Recommendation"/>

                        <div class="alert alert-secondary" role="alert">
                            <field name="risk_explanation" nolabel="1"/>
                        </div>

                        <!-- AI BUSINESS INSIGHT -->
                        <separator string="AI Business Insight"/>

                        <div class="alert alert-info" role="alert">

                            <field name="ai_insight"
                                nolabel="1"
                                readonly="1"/>

                            <button
                                name="action_generate_ai_insight"
                                string="Generate AI Insight"
                                type="object"
                                class="btn-primary"
                                invisible="not product_id"
                            />

                        </div>

                    </sheet>
                </form>
            </field>
        </record>

    <!-- DASHBOARD VIEW -->
    <record id="business_ai_view_dashboard" model="ir.ui.view">
        <field name="name">business.dashboard.form</field>
        <field name="model">business.dashboard</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>

                    <!-- Dashboard Header -->
                    <div class="text-center" style="padding: 20px 0;">
                        <h1 style="font-size: 36px; font-weight: 600;">
                            OdooPulse
                        </h1>

                        <p class="text-muted" style="font-size: 16px;">
                            Business Risk &amp; Decision Assistant
                        </p>

                        <p style="font-size: 14px;">
                            Turn Odoo business data into actionable insights.
                        </p>
                    </div>

                    <!-- Risk Summary -->
                    <separator string="Stockout Risk Overview"/>
                        <group col="3">
                            <group>
                                <div class="alert alert-danger text-center"
                                    style="min-height: 120px; padding: 20px;">
                                    <h2 style="font-size: 32px; margin-bottom: 8px;">
                                        <field name="high_risk_count"/>
                                    </h2>
                                    <strong style="font-size: 16px;">
                                        High Risk
                                    </strong>
                                    <br/>
                                    Products need attention
                                </div>
                            </group>

                            <group>
                                <div class="alert alert-warning text-center"
                                    style="min-height: 120px; padding: 20px;">
                                    <h2 style="font-size: 32px; margin-bottom: 8px;">
                                        <field name="medium_risk_count"/>
                                    </h2>
                                    <strong style="font-size: 16px;">
                                        Medium Risk
                                    </strong>
                                    <br/>
                                    Products to monitor
                                </div>
                            </group>

                            <group>
                                <div class="alert alert-success text-center"
                                    style="min-height: 120px; padding: 20px;">
                                    <h2 style="font-size: 32px; margin-bottom: 8px;">
                                        <field name="low_risk_count"/>
                                    </h2>
                                    <strong style="font-size: 16px;">
                                        Low Risk
                                    </strong>
                                    <br/>
                                    Products stable
                                </div>
                            </group>
                        </group>

                    <!-- Priority Actions -->
                    <separator string="Priority Actions"/>
                        <div class="alert alert-warning"
                            style="padding: 20px;">

                            <h3 style="margin-top: 0;">
                                What should you act on right now?
                            </h3>

                            <p class="text-muted">
                                OdooPulse prioritizes products based on how soon they
                                are expected to run out of stock.
                            </p>

                            <div style="margin-top: 15px;">
                                <field name="priority_message"
                                    nolabel="1"/>
                            </div>

                        </div>
                    
                    <!-- OVERSTOCK RISK -->
                    <separator string="Overstock Risk"/>
                    <div class="alert alert-info"
                        style="padding: 20px;">

                        <h3 style="margin-top: 0;">
                            Inventory that may not be moving
                        </h3>

                        <p class="text-muted">
                            OdooPulse also identifies products that may be holding
                            excessive or slow-moving inventory.
                        </p>

                        <group col="2">
                            <group>
                                <div class="text-center"
                                    style="padding: 15px;">
                                    <h2 style="font-size: 30px;">
                                        <field name="overstock_high_count"/>
                                    </h2>
                                    <strong>High Overstock Risk</strong>
                                    <br/>
                                    Products
                                </div>
                            </group>

                            <group>
                                <div class="text-center"
                                    style="padding: 15px;">
                                    <h2 style="font-size: 30px;">
                                        <field name="overstock_medium_count"/>
                                    </h2>
                                    <strong>Medium Overstock Risk</strong>
                                    <br/>
                                    Products
                                </div>
                            </group>
                        </group>

                        <div style="margin-top: 15px;">
                            <field name="overstock_message"
                                nolabel="1"/>
                        </div>

                    </div>
                </sheet>
                
            </form>
        </field>
    </record>

    <!-- DEFAULT ODOOPULSE DASHBOARD RECORD -->
    <record id="business_dashboard_default" model="business.dashboard">
        <field name="name">OdooPulse Dashboard</field>
    </record>

</odoo>