<odoo>

    <record id="business_ai_action" model="ir.actions.act_window">
        <field name="name">OdooPulse</field>
        <field name="res_model">business.ai</field>
        <field name="view_mode">list,form</field>
    </record>

<!-- This is to connect the OdooPulse menu to the python model business_ai.py through the business.ai module in odoo -->
    <menuitem
        id="business_ai_menu_root"
        name="OdooPulse"
        action="business_ai_action"
    />

</odoo>